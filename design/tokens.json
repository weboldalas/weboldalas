{
  "color": {
    "void": {
      "$value": "#000000",
      "$type": "color",
      "$description": "Page canvas, all section backgrounds, negative space"
    },
    "bone-white": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "Headlines, body text, icon fills, active nav"
    },
    "ash-gray": {
      "$value": "#9a9a9a",
      "$type": "color",
      "$description": "Muted nav, ghost links, secondary labels"
    },
    "silver-mist": {
      "$value": "#bdbdbd",
      "$type": "color",
      "$description": "Tertiary body text, captions"
    },
    "electric-iris": {
      "$value": "#8052ff",
      "$type": "color",
      "$description": "Filled primary button, brand accents (never a large surface)"
    },
    "saffron-spark": {
      "$value": "#ffb829",
      "$type": "color",
      "$description": "Uppercase labels, emphasis, accent links"
    },
    "deep-verdant": {
      "$value": "#15846e",
      "$type": "color",
      "$description": "Particle palette / deep accent only"
    }
  },
  "font": {
    "ppneuemontreal": {
      "$value": [
        "PPNeueMontreal",
        "Inter Tight",
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ],
      "$type": "fontFamily",
      "$description": "Single typeface. Inter Tight is the free substitute in use (next/font)."
    }
  },
  "typography": {
    "caption": {
      "$value": {
        "fontFamily": "{font.ppneuemontreal}",
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0em"
      },
      "$type": "typography"
    },
    "nav-label": {
      "$value": {
        "fontFamily": "{font.ppneuemontreal}",
        "fontSize": "14px",
        "fontWeight": 600,
        "lineHeight": 1.2,
        "letterSpacing": "0.025em"
      },
      "$type": "typography"
    },
    "body": {
      "$value": {
        "fontFamily": "{font.ppneuemontreal}",
        "fontSize": "18px",
        "fontWeight": 200,
        "lineHeight": 1.5,
        "letterSpacing": "0em"
      },
      "$type": "typography"
    },
    "heading-2xs": {
      "$value": {
        "fontFamily": "{font.ppneuemontreal}",
        "fontSize": "24px",
        "fontWeight": 400,
        "lineHeight": 1.25,
        "letterSpacing": "-0.02em"
      },
      "$type": "typography"
    },
    "heading-xs": {
      "$value": {
        "fontFamily": "{font.ppneuemontreal}",
        "fontSize": "27px",
        "fontWeight": 400,
        "lineHeight": 1,
        "letterSpacing": "0em"
      },
      "$type": "typography"
    },
    "subheading": {
      "$value": {
        "fontFamily": "{font.ppneuemontreal}",
        "fontSize": "36px",
        "fontWeight": 400,
        "lineHeight": 1.2,
        "letterSpacing": "0em"
      },
      "$type": "typography"
    },
    "heading-sm": {
      "$value": {
        "fontFamily": "{font.ppneuemontreal}",
        "fontSize": "42px",
        "fontWeight": 400,
        "lineHeight": 1.2,
        "letterSpacing": "-0.04em"
      },
      "$type": "typography"
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.ppneuemontreal}",
        "fontSize": "48px",
        "fontWeight": 400,
        "lineHeight": 1.1,
        "letterSpacing": "-0.035em"
      },
      "$type": "typography"
    },
    "heading-lg": {
      "$value": {
        "fontFamily": "{font.ppneuemontreal}",
        "fontSize": "78px",
        "fontWeight": 400,
        "lineHeight": 1.1,
        "letterSpacing": "-0.04em"
      },
      "$type": "typography"
    },
    "display": {
      "$value": {
        "fontFamily": "{font.ppneuemontreal}",
        "fontSize": "113px",
        "fontWeight": 400,
        "lineHeight": 1.1,
        "letterSpacing": "-0.04em"
      },
      "$type": "typography"
    }
  },
  "spacing": {
    "6": {
      "$value": "6px",
