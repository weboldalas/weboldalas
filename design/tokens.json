      "$description": "Tailwind: 9 (e.g. p-9)"
    },
    "60": {
      "$value": "60px",
      "$type": "dimension",
      "$description": "Tailwind: 15 (e.g. p-15)"
    },
    "96": {
      "$value": "96px",
